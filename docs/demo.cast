[3.060798, "o", "   hexlet-path-size - print size of a file or directory; supports -r (recursive), -H (human-readable), -a (include hidden)\r\n\r\nUSAGE:\r\n"]
[3.060844, "o", "   hexlet-path-size [global options] <path>\r\n\r\nGLOBAL OPTIONS:\r\n"]
